# ============================================================
# TechNova World — Environment Variables Template
# ============================================================
# Yeh file ko copy karke ".env" naam se save karo (same folder mein)
# Phir apni REAL keys yahan daalo. ".env" file kabhi GitHub pe push
# nahi hogi (.gitignore mein already block hai).
#
# Command: cp .env.example .env
# ============================================================

# ── GEMINI API — FREE — aistudio.google.com se lo ────────────
GEMINI_API_KEY=

# ── OPENROUTER — FREE fallback — openrouter.ai se lo ─────────
# Optional but recommended: Gemini fail/deprecated hone par yeh
# automatically Llama/DeepSeek free models try karega.
OPENROUTER_API_KEY=

# ── LINKEDIN — developer.linkedin.com se lo ──────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# ── TWITTER (optional — agar Twitter API use karna hai) ──────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ── WEB DASHBOARD ─────────────────────────────────────────────
# Local testing ke liye koi bhi random string. Render pe yeh
# auto-generate ho jaata hai (render.yaml mein generateValue: true)
FLASK_SECRET_KEY=change-this-to-anything-locally

# ── BRAND (optional overrides — defaults already set) ────────
BRAND_NAME=TechNova World
WATERMARK_TEXT=TechNova World
WATERMARK_POSITION=bottom_right

# ── SCHEDULE (IST 24h format, optional overrides) ─────────────
LINKEDIN_POST_TIME=21:00
MEDIUM_POST_TIME=18:00

# ── Suppress startup warnings if running tests without keys ──
SUPPRESS_CONFIG_WARNINGS=0
