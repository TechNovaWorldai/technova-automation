# ============================================================
# TechNova World — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file to ".env" in the same directory:
#        cp .env.example .env   (Mac/Linux)
#        copy .env.example .env  (Windows)
#   2. Fill in your real API keys below.
#   3. NEVER commit ".env" to Git — it is already listed in
#      .gitignore and will not be pushed.
#
# PRODUCTION (GitHub Actions / Render):
#   Do NOT create a .env file on the server.
#   Instead, add each key as a repository Secret (GitHub)
#   or an Environment Variable (Render) using the same names.
# ============================================================


# ── GEMINI API (Required) ────────────────────────────────────
# Free — get yours at: https://aistudio.google.com
# Provides ~1,500 requests/day on the free tier.
GEMINI_API_KEY=


# ── OPENROUTER (Optional — Recommended) ──────────────────────
# Free — get yours at: https://openrouter.ai → Keys
# Used as automatic fallback if Gemini is rate-limited or down.
# Gives access to Llama 3.3 70B, DeepSeek, and other free models.
OPENROUTER_API_KEY=


# ── LINKEDIN (Required for auto-posting) ─────────────────────
# Access Token: https://developer.linkedin.com/tools/oauth
# Required scopes: r_liteprofile, w_member_social
# Note: tokens expire every 60 days — renew before expiry!
LINKEDIN_ACCESS_TOKEN=

# Your LinkedIn Company Page numeric ID (from the page URL).
# Leave blank to post only to your personal profile.
LINKEDIN_ORGANIZATION_ID=

# Your Person URN — leave blank to let the app fetch it automatically.
# Format: urn:li:person:XXXXXXXX
# Only set this manually if auto-fetch fails (missing r_liteprofile scope).
LINKEDIN_PERSON_URN=


# ── TWITTER / X (Optional) ───────────────────────────────────
# Twitter's free API tier does not support posting — used only
# for analytics or if you have an Elevated/Pro API subscription.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=


# ── WEB DASHBOARD ─────────────────────────────────────────────
# Any random string works for local development.
# Render auto-generates this in production (generateValue: true).
FLASK_SECRET_KEY=change-this-to-a-random-string-locally


# ── BRAND SETTINGS (optional — defaults already set in config.py) ──
BRAND_NAME=TechNova World
WATERMARK_TEXT=TechNova World
WATERMARK_POSITION=bottom_right


# ── POSTING SCHEDULE (IST, 24-hour format) ────────────────────
LINKEDIN_POST_TIME=21:00
MEDIUM_POST_TIME=18:00


# ── SUPPRESS STARTUP WARNINGS (for testing without keys) ──────
# Set to 1 when running tests in CI where API keys are not set.
SUPPRESS_CONFIG_WARNINGS=0
