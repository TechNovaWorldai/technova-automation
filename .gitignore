# ============================================================
# TechNova World — .gitignore
# Yeh files KABHI GitHub pe push NAHI hongi
# ============================================================

# Secrets — CRITICAL, kabhi commit mat karo
.env
.env.local
*.key
secrets.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
env/
.venv/

# Generated content + queue MUST be committed — GitHub Actions runners are
# ephemeral (fresh checkout every run), so this is the ONLY way state
# (pending posts, generated drafts) survives between the Sunday batch job
# and the Mon-Fri posting job. Do NOT re-ignore these.
# generated/*.txt   -- (intentionally NOT ignored, see note above)
# queue/*.json      -- (intentionally NOT ignored, see note above)
generated/deep_research/*.txt
generated/*.pdf
!generated/.gitkeep

# Runtime data
logs/*.log
logs/*.json
!queue/.gitkeep
!logs/.gitkeep

# Images (apni personal images push mat karo)
images/*.jpg
images/*.jpeg
images/*.png
images/watermarked/*
!images/.gitkeep

# Assets (brand voice config — agar personal info hai toh)
# assets/brand_voice.json  # uncomment if you want to keep this private

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Test artifacts
tests/.tmp*
tests/.wm*
tests/.batch*
tests/.load*
tests/.corrupt*
